--- VideoEncoder.forward: permute then Swin3D-B, no resize/renormalise: projects/eeg_vedio/src/models/video_encoder/video_encoder.py:57-62
     57|     def forward(self, x):
     58|         x = x.permute(0, 2, 1, 3, 4)  # Change shape from (B, T, C, H, W) to (B, C, T, H, W)
     59|         x = self.swin_transformer(x)  # Process the video input through the transformer
     60|         x = self.proj_norm(x)  # Normalize the output
     61|         x = self.proj(x)  # Generate the output vector representation
     62|         return x

